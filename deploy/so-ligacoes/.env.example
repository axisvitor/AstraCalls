# Imagem gerada a partir deste fork (a oficial não tem o modo só ligações).
ASTRACALLS_IMAGE=seuusuario/astracalls:so-ligacoes
# Domínio do painel (o Caddy emite o certificado).
ASTRACALLS_DOMAIN=ligacoes.sualoja.com.br
# Chave-mestra (administrador). Gere com: openssl rand -hex 32
WACALLS_API_KEY=
# Senha do Postgres próprio do AstraCalls. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
# Rede docker compartilhada com o Caddy.
CADDY_NETWORK=caddy
# Opcionais
WACALLS_RING_TIMEOUT_SECONDS=90
WACALLS_DEVICE_NAME=AstraCalls
